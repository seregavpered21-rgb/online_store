# Neon / Vercel Postgres pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Public canonical URL used for metadata, sitemap, and robots in production
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Created automatically when a Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me